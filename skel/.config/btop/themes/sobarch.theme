# Base16 OneDark
# Author: Lalit Magant (http://github.com/tilal6991)
#
# btop's own .theme format (theme[key]="#RRGGBB", one per line), every
# key btop's built-in Default theme defines, so none silently falls back
# to that theme's own unrelated colors. Each meter's gradient runs
# between two of the scheme's accents rather than from a near-background
# shade like Default's, so graphs stay legible on any scheme. Selected by
# ~/.config/btop/btop.conf's color_theme; btop re-reads it on its next
# launch, there is no live reload.

theme[main_bg]="#282c34"
theme[main_fg]="#abb2bf"
theme[title]="#abb2bf"
theme[hi_fg]="#61afef"
theme[selected_bg]="#3e4451"
theme[selected_fg]="#abb2bf"
theme[inactive_fg]="#545862"
theme[graph_text]="#565c64"
theme[meter_bg]="#3e4451"
theme[proc_misc]="#56b6c2"
theme[cpu_box]="#98c379"
theme[mem_box]="#e5c07b"
theme[net_box]="#c678dd"
theme[proc_box]="#61afef"
theme[div_line]="#3e4451"
theme[temp_start]="#61afef"
theme[temp_mid]="#c678dd"
theme[temp_end]="#e06c75"
theme[cpu_start]="#98c379"
theme[cpu_mid]="#e5c07b"
theme[cpu_end]="#e06c75"
theme[free_start]="#98c379"
theme[free_mid]="#98c379"
theme[free_end]="#56b6c2"
theme[cached_start]="#56b6c2"
theme[cached_mid]="#56b6c2"
theme[cached_end]="#61afef"
theme[available_start]="#e5c07b"
theme[available_mid]="#e5c07b"
theme[available_end]="#d19a66"
theme[used_start]="#d19a66"
theme[used_mid]="#d19a66"
theme[used_end]="#e06c75"
theme[download_start]="#61afef"
theme[download_mid]="#61afef"
theme[download_end]="#56b6c2"
theme[upload_start]="#c678dd"
theme[upload_mid]="#c678dd"
theme[upload_end]="#d19a66"
theme[process_start]="#98c379"
theme[process_mid]="#e5c07b"
theme[process_end]="#e06c75"
theme[proc_pause_bg]="#e06c75"
theme[proc_follow_bg]="#61afef"
theme[proc_banner_bg]="#c678dd"
theme[proc_banner_fg]="#282c34"
theme[followed_bg]="#61afef"
theme[followed_fg]="#282c34"
