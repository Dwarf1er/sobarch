sort=-time
layer=overlay
include=~/.config/mako/colors
anchor=top-right
margin=12
padding=16
width=320
height=110
border-size=1
border-radius=20
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=0
font=D2CodingLigature Nerd Font Mono 11

[urgency=critical]
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category

[mode=do-not-disturb]
invisible=1

# Volume, mic and brightness toasts from osd.sh; a key press is deliberate,
# so they show during do-not-disturb too.
[category=osd]
anchor=bottom-center
margin=0,0,80,0
width=280
height=80
default-timeout=1200

[mode=do-not-disturb category=osd]
invisible=0
