// Base16 OneDark
// Author: Lalit Magant (http://github.com/tilal6991)
// Renders the whole file: fastfetch has no include directive.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/sobarch-logo.txt",
    "color": {
      "1": "#61afef",
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "keyColor": "#61afef",
    },
    {
      "type": "host",
      "keyColor": "#61afef",
    },
    {
      "type": "kernel",
      "keyColor": "#61afef",
    },
    {
      "type": "uptime",
      "keyColor": "#61afef",
    },
    {
      "type": "packages",
      "keyColor": "#61afef",
    },
    {
      "type": "shell",
      "keyColor": "#61afef",
    },
    {
      "type": "display",
      "keyColor": "#61afef",
    },
    {
      "type": "de",
      "keyColor": "#61afef",
    },
    {
      "type": "wm",
      "keyColor": "#61afef",
    },
    {
      "type": "terminal",
      "keyColor": "#61afef",
    },
    {
      "type": "cpu",
      "keyColor": "#61afef",
    },
    {
      "type": "gpu",
      "keyColor": "#61afef",
    },
    {
      "type": "memory",
      "keyColor": "#61afef",
    },
    {
      "type": "disk",
      "keyColor": "#61afef",
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
    },
  ],
}
