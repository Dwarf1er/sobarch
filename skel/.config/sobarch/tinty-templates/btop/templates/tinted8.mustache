# Tinted8 {{scheme.name}}
# Author: {{scheme.author}}
#
# btop's own .theme format (theme[key]="#RRGGBB", one per line), every
# key btop's built-in Default theme defines, so none silently falls back
# to that theme's own unrelated colors. Each meter's gradient runs
# between two of the scheme's accents rather than from a near-background
# shade like Default's, so graphs stay legible on any scheme. Selected by
# ~/.config/btop/btop.conf's color_theme; btop re-reads it on its next
# launch, there is no live reload.

theme[main_bg]="#{{ui.global.background.normal.hex}}"
theme[main_fg]="#{{ui.global.foreground.normal.hex}}"
theme[title]="#{{ui.global.foreground.normal.hex}}"
theme[hi_fg]="#{{palette.blue.normal.hex}}"
theme[selected_bg]="#{{ui.selection.background.hex}}"
theme[selected_fg]="#{{ui.global.foreground.normal.hex}}"
theme[inactive_fg]="#{{palette.gray.dim.hex}}"
theme[graph_text]="#{{palette.gray.normal.hex}}"
theme[meter_bg]="#{{ui.selection.background.hex}}"
theme[proc_misc]="#{{palette.cyan.normal.hex}}"
theme[cpu_box]="#{{palette.green.normal.hex}}"
theme[mem_box]="#{{palette.yellow.normal.hex}}"
theme[net_box]="#{{palette.magenta.normal.hex}}"
theme[proc_box]="#{{palette.blue.normal.hex}}"
theme[div_line]="#{{ui.selection.background.hex}}"
