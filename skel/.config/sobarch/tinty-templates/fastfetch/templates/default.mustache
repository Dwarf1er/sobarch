// Base16 {{scheme-name}}
// Author: {{scheme-author}}
//
// fastfetch.jsonc has no include directive, so this template renders
// the whole file, module list included, rather than just a color
// snippet. Structure loosely follows Nukecraft5419/fastfetch's themes
// (github.com/Nukecraft5419/fastfetch), simplified.
//
// logo.source is a plain static file (~/.config/fastfetch/sobarch-
// logo.txt, deployed via skel like everything else here), not itself
// tinty-templated: it carries $1 placeholders fastfetch's own "file"
// logo type replaces at render time, driven by logo.color.1 below,
// which is what actually varies per scheme.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/sobarch-logo.txt",
    "color": {
      "1": "#{{base0D-hex}}",
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "host",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "kernel",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "uptime",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "packages",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "shell",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "display",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "de",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "wm",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "terminal",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "cpu",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "gpu",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "memory",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "disk",
      "keyColor": "#{{base0D-hex}}",
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
    },
  ],
}
