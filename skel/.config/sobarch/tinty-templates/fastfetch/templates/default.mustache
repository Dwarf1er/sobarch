// Base16 {{scheme-name}}
// Author: {{scheme-author}}
//
// fastfetch.jsonc has no include directive, so this template renders
// the whole file, module list included, rather than just a color
// snippet. Structure loosely follows Nukecraft5419/fastfetch's themes
// (github.com/Nukecraft5419/fastfetch), simplified: no custom logo
// asset, fastfetch's own distro-logo auto-detection is left as-is.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " ",
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "host",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "kernel",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "uptime",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "packages",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "shell",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "display",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "de",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "wm",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "terminal",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "cpu",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "gpu",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "memory",
      "keyColor": "#{{base0D-hex}}",
    },
    {
      "type": "disk",
      "keyColor": "#{{base0D-hex}}",
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
    },
  ],
}
