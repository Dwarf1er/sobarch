# Tinted8 {{scheme.name}}
# Author: {{scheme.author}}
# Renders the whole file: hyprlock has no include directive.

# Flat color rather than a blurred screenshot, which hurt label contrast.
background {
    monitor =
    path =
    color = rgba({{ui.global.background.normal.hex}}ff)
}

# The clock/date/logo/username/input stack is spaced as one group centered
# on screen; retune it as a whole.
label {
    monitor =
    text = cmd[update:1000] echo "$(date +'%H:%M')"
    color = rgba({{ui.global.foreground.normal.hex}}ff)
    font_size = 96
    font_family = D2CodingLigature Nerd Font Mono
    position = 0, 170
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] echo "$(date +'%A, %B %d')"
    color = rgba({{palette.cyan.normal.hex}}ff)
    font_size = 20
    font_family = D2CodingLigature Nerd Font Mono
    position = 0, 80
    halign = center
    valign = center
}

# rounding = -1 crops to a circle; the PNG is padded so the mark isn't clipped.
image {
    monitor =
    path = ~/.config/hypr/sobarch-logo.png
    size = 130
    rounding = -1
    position = 0, -25
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:0] echo "$USER"
    color = rgba({{palette.blue.normal.hex}}ff)
    font_size = 16
    font_family = D2CodingLigature Nerd Font Mono
    position = 0, -130
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 280, 56
    outline_thickness = 3
    inner_color = rgba(00000000)

    outer_color = rgba({{palette.blue.normal.hex}}ee) rgba({{palette.cyan.normal.hex}}ee) 45deg
    check_color = rgba({{palette.green.normal.hex}}ee) rgba({{palette.cyan.normal.hex}}ee) 120deg
    fail_color = rgba({{palette.red.normal.hex}}ee) rgba({{palette.orange.dim.hex}}ee) 40deg

    font_color = rgb({{ui.global.foreground.normal.hex}})
    fade_on_empty = false
    rounding = 28
    position = 0, -190
    halign = center
    valign = center
}
