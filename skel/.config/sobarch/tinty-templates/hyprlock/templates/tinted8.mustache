# Tinted8 {{scheme.name}}
# Author: {{scheme.author}}
#
# hyprlock has no config-splitting directive (unlike hyprland.conf's
# `source=`), so this template renders the whole file, static settings
# included, rather than just a color snippet.

# Solid color, no screenshot/blur: a blurred capture of the last frame
# reads as noise behind the labels below and tanks contrast, so the
# lock screen is a flat panel with the mark instead.
background {
    monitor =
    path =
    color = rgba({{ui.global.background.normal.hex}}ff)
}

image {
    monitor =
    path = ~/.config/hypr/sobarch-logo.png
    size = 130
    position = 0, 380
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:1000] echo "$(date +'%H:%M')"
    color = rgba({{ui.global.foreground.normal.hex}}ff)
    font_size = 96
    font_family = D2CodingLigature Nerd Font Mono
    position = 0, 260
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] echo "$(date +'%A, %B %d')"
    color = rgba({{palette.cyan.normal.hex}}ff)
    font_size = 20
    font_family = D2CodingLigature Nerd Font Mono
    position = 0, 180
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:0] echo "$USER"
    color = rgba({{palette.blue.normal.hex}}ff)
    font_size = 16
    font_family = D2CodingLigature Nerd Font Mono
    position = 0, 70
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 280, 56
    outline_thickness = 3
    inner_color = rgba(00000000)

    outer_color = rgba({{palette.blue.normal.hex}}ee) rgba({{palette.cyan.normal.hex}}ee) 45deg
    check_color = rgba({{palette.green.normal.hex}}ee) rgba({{palette.cyan.normal.hex}}ee) 120deg
    fail_color = rgba({{palette.red.normal.hex}}ee) rgba({{palette.orange.dim.hex}}ee) 40deg

    font_color = rgb({{ui.global.foreground.normal.hex}})
    fade_on_empty = false
    rounding = 28
    position = 0, 0
    halign = center
    valign = center
}
