# Tinted8 {{scheme.name}}
# Author: {{scheme.author}}
#
# hyprlock has no config-splitting directive (unlike hyprland.conf's
# `source=`), so this template renders the whole file, static settings
# included, rather than just a color snippet.

# Solid color, no screenshot/blur: a blurred capture of the last frame
# reads as noise behind the labels below and tanks contrast, so the
# lock screen is a flat panel with the mark instead.
background {
    monitor =
    path =
    color = rgba({{ui.global.background.normal.hex}}ff)
}

# The whole clock/date/logo/username/input stack below is laid out as
# one group, not five independently-placed widgets: each position is
# picked so there's a deliberate ~20-30 unit gap between one widget's
# edge and the next (using each one's own font_size/size to estimate
# its rendered extent), then the whole group is shifted so its total
# span is centered on the screen (halign/valign=center's actual anchor
# point, confirmed via testing to be true screen center, not wherever
# this stack happened to sit before). Previous versions anchored the
# clock at a fixed position with everything else hung below/around it,
# which read as off-center overall and left too little room between
# the date and username labels for the image below. If any of these
# numbers need retuning after a real test, keep the whole group's
# total span symmetric around 0 rather than moving one widget alone.
label {
    monitor =
    text = cmd[update:1000] echo "$(date +'%H:%M')"
    color = rgba({{ui.global.foreground.normal.hex}}ff)
    font_size = 96
    font_family = D2CodingLigature Nerd Font Mono
    position = 0, 170
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] echo "$(date +'%A, %B %d')"
    color = rgba({{palette.cyan.normal.hex}}ff)
    font_size = 20
    font_family = D2CodingLigature Nerd Font Mono
    position = 0, 80
    halign = center
    valign = center
}

# rounding = -1 (hyprlock's own default for `image`, made explicit
# here) crops to a circle inscribed in `size`. The source PNG is
# rendered with the mark scaled down and padded within its canvas
# specifically so that circle doesn't clip it: the artwork's own
# design bleeds almost to the edge of its square canvas (its bounding
# box reaches within ~3px of the top/bottom edge), which a circular
# crop at 1:1 would cut into.
image {
    monitor =
    path = ~/.config/hypr/sobarch-logo.png
    size = 130
    rounding = -1
    position = 0, -25
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:0] echo "$USER"
    color = rgba({{palette.blue.normal.hex}}ff)
    font_size = 16
    font_family = D2CodingLigature Nerd Font Mono
    position = 0, -130
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 280, 56
    outline_thickness = 3
    inner_color = rgba(00000000)

    outer_color = rgba({{palette.blue.normal.hex}}ee) rgba({{palette.cyan.normal.hex}}ee) 45deg
    check_color = rgba({{palette.green.normal.hex}}ee) rgba({{palette.cyan.normal.hex}}ee) 120deg
    fail_color = rgba({{palette.red.normal.hex}}ee) rgba({{palette.orange.dim.hex}}ee) 40deg

    font_color = rgb({{ui.global.foreground.normal.hex}})
    fade_on_empty = false
    rounding = 28
    position = 0, -190
    halign = center
    valign = center
}
