# Base16 {{scheme-name}}
# Author: {{scheme-author}}
#
# hyprlock has no config-splitting directive (unlike hyprland.conf's
# `source=`), so this template renders the whole file, static settings
# included, rather than just a color snippet.

# Solid color, no screenshot/blur: a blurred capture of the last frame
# reads as noise behind the labels below and tanks contrast, so the
# lock screen is a flat panel with the mark instead.
background {
    monitor =
    path =
    color = rgba({{base00-hex}}ff)
}

# Between the username and date labels (70 and 180), not stacked above
# the clock or below the input field: a small offset from center like
# this stays clear of the screen edge on any real display, unlike the
# 380/-170 offsets tried earlier. Exact clearance against the
# neighboring labels' real rendered text height isn't confirmed against
# a live display though (see both labels' font_size for the numbers
# this was sized against); shrink `size` if it still overlaps either
# one on real hardware.
#
# rounding = -1 (hyprlock's own default for `image`, made explicit
# here) crops to a circle inscribed in `size`. The source PNG is
# rendered with the mark scaled down and padded within its canvas
# specifically so that circle doesn't clip it: the artwork's own
# design bleeds almost to the edge of its square canvas (its bounding
# box reaches within ~3px of the top/bottom edge), which a circular
# crop at 1:1 would cut into.
image {
    monitor =
    path = ~/.config/hypr/sobarch-logo.png
    size = 120
    rounding = -1
    position = 0, 125
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:1000] echo "$(date +'%H:%M')"
    color = rgba({{base05-hex}}ff)
    font_size = 96
    font_family = D2CodingLigature Nerd Font Mono
    position = 0, 260
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] echo "$(date +'%A, %B %d')"
    color = rgba({{base0C-hex}}ff)
    font_size = 20
    font_family = D2CodingLigature Nerd Font Mono
    position = 0, 180
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:0] echo "$USER"
    color = rgba({{base0D-hex}}ff)
    font_size = 16
    font_family = D2CodingLigature Nerd Font Mono
    position = 0, 70
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 280, 56
    outline_thickness = 3
    inner_color = rgba(00000000)

    outer_color = rgba({{base0D-hex}}ee) rgba({{base0C-hex}}ee) 45deg
    check_color = rgba({{base0B-hex}}ee) rgba({{base0C-hex}}ee) 120deg
    fail_color = rgba({{base08-hex}}ee) rgba({{base0F-hex}}ee) 40deg

    font_color = rgb({{base05-hex}})
    fade_on_empty = false
    rounding = 28
    position = 0, 0
    halign = center
    valign = center
}
