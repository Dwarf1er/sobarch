# Base16 {{scheme-name}}
# Author: {{scheme-author}}
#
# hyprlock has no config-splitting directive (unlike hyprland.conf's
# `source=`), so this template renders the whole file, static settings
# included, rather than just a color snippet.

# Solid color, no screenshot/blur: a blurred capture of the last frame
# reads as noise behind the labels below and tanks contrast, so the
# lock screen is a flat panel with the mark instead.
background {
    monitor =
    path =
    color = rgba({{base00-hex}}ff)
}

# Below the input field, not above the clock: stacking another widget
# above the clock (already at position 260) leaves no headroom on a
# shorter display (e.g. a 768px-tall panel, half-height 384) once the
# clock's own font extent and a real gap are accounted for. Below
# center is unused by every other widget here, so there's guaranteed
# clearance regardless of screen height.
image {
    monitor =
    path = ~/.config/hypr/sobarch-logo.png
    size = 100
    position = 0, -170
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:1000] echo "$(date +'%H:%M')"
    color = rgba({{base05-hex}}ff)
    font_size = 96
    font_family = D2CodingLigature Nerd Font Mono
    position = 0, 260
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] echo "$(date +'%A, %B %d')"
    color = rgba({{base0C-hex}}ff)
    font_size = 20
    font_family = D2CodingLigature Nerd Font Mono
    position = 0, 180
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:0] echo "$USER"
    color = rgba({{base0D-hex}}ff)
    font_size = 16
    font_family = D2CodingLigature Nerd Font Mono
    position = 0, 70
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 280, 56
    outline_thickness = 3
    inner_color = rgba(00000000)

    outer_color = rgba({{base0D-hex}}ee) rgba({{base0C-hex}}ee) 45deg
    check_color = rgba({{base0B-hex}}ee) rgba({{base0C-hex}}ee) 120deg
    fail_color = rgba({{base08-hex}}ee) rgba({{base0F-hex}}ee) 40deg

    font_color = rgb({{base05-hex}})
    fade_on_empty = false
    rounding = 28
    position = 0, 0
    halign = center
    valign = center
}
