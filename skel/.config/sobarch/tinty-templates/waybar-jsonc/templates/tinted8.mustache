{
  "clock": {
    "calendar": {
      "format": {
        "months": "<span color='#{{palette.blue.normal.hex}}'><b>{}</b></span>",
        "days": "<span color='#{{ui.global.foreground.normal.hex}}'><b>{}</b></span>",
        "weeks": "<span color='#{{palette.cyan.normal.hex}}'><b>W{}</b></span>",
        "weekdays": "<span color='#{{palette.cyan.normal.hex}}'><b>{}</b></span>",
        "today": "<span background='#{{palette.blue.normal.hex}}' color='#{{ui.global.background.normal.hex}}'><b> {} </b></span>"
      }
    }
  }
}
