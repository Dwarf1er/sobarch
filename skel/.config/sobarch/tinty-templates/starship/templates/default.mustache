# Base16 {{scheme-name}}
# Author: {{scheme-author}}
#
# starship.toml has no include directive, so this template renders the
# whole file, static settings included, rather than just a color snippet.

format = """
$directory\
$git_branch\
$git_status\
$fill\
$cmd_duration
$character"""

right_format = ""
add_newline = true

[fill]
symbol = " "

[directory]
style = "bold fg:#{{base0D-hex}}"
truncation_length = 3
truncate_to_repo = true

[git_branch]
style = "fg:#{{base0C-hex}}"
symbol = " "

[git_status]
style = "fg:#{{base08-hex}}"

[cmd_duration]
min_time = 2000
style = "fg:#{{base0A-hex}}"

[character]
success_symbol = "[❯](bold fg:#{{base0B-hex}})"
error_symbol = "[❯](bold fg:#{{base08-hex}})"
