# Tinted8 {{scheme.name}}
# Author: {{scheme.author}}
#
# starship.toml has no include directive, so this template renders the
# whole file, static settings included, rather than just a color snippet.

format = """
$directory\
$git_branch\
$git_status\
$fill\
$cmd_duration
$character"""

right_format = ""
add_newline = true

[fill]
symbol = " "

[directory]
style = "bold fg:#{{palette.blue.normal.hex}}"
truncation_length = 3
truncate_to_repo = true

[git_branch]
style = "fg:#{{palette.cyan.normal.hex}}"
symbol = " "

[git_status]
style = "fg:#{{palette.red.normal.hex}}"

[cmd_duration]
min_time = 2000
style = "fg:#{{palette.yellow.normal.hex}}"

[character]
success_symbol = "[❯](bold fg:#{{palette.green.normal.hex}})"
error_symbol = "[❯](bold fg:#{{palette.red.normal.hex}})"
