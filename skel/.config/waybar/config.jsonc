{
  // Calendar colors, rendered by tinty since Pango spans can't use CSS.
  "include": ["~/.config/waybar/calendar.jsonc"],
  "layer": "top",
  "position": "top",
  "height": 44,
  "margin-top": 8,
  "margin-left": 8,
  "margin-right": 8,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["custom/fcitx5", "custom/dnd", "network", "bluetooth", "custom/system", "battery"],

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "all-outputs": true
  },

  "clock": {
    "interval": 1,
    "format": "{:%a %d  %H:%M}",
    "tooltip-format": "<big>{:%Y}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
      "on-click-right": "shift_reset"
    }
  },

  "network": {
    "format-wifi": " ",
    "format-ethernet": " ",
    "format-disconnected": " ",
    "tooltip-format-wifi": "Wi-Fi: {essid} · {signalStrength}%",
    "tooltip-format-ethernet": "Ethernet: {ifname}",
    "tooltip-format-disconnected": "Network: offline",
    "on-click": "bash ~/.config/hypr/scripts/network-menu.sh"
  },

  "bluetooth": {
    "format": " ",
    "format-connected": " {num_connections}",
    "tooltip-format": "Bluetooth: on",
    "tooltip-format-off": "Bluetooth: off",
    "tooltip-format-disabled": "Bluetooth: blocked",
    "tooltip-format-connected": "Bluetooth: {num_connections} connected\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} · {device_battery_percentage}%",
    "on-click": "bash ~/.config/hypr/scripts/bluetooth-menu.sh"
  },

  "custom/fcitx5": {
    "exec": "~/.config/waybar/scripts/fcitx5-status.sh",
    "interval": 1,
    "return-type": "json",
    "format": "{text}",
    "on-click": "fcitx5-remote -t"
  },

  "battery": {
    "format": "{capacity}%",
    "format-full": "Charged",
    "interval": 5,
    "on-click": "bash ~/.config/hypr/scripts/power-profile-menu.sh",
    "states": {
      "warning": 20,
      "critical": 10
    },
    "tooltip-format": "Battery: {capacity}% · {timeTo}"
  },

  "custom/dnd": {
    "exec": "~/.config/waybar/scripts/dnd-status.sh",
    "interval": 2,
    "return-type": "json",
    "format": "{}",
    "on-click": "makoctl mode -t do-not-disturb"
  },

  "custom/system": {
    "exec": "~/.config/waybar/scripts/system-status.sh",
    "interval": 5,
    "return-type": "json",
    "format": "{}",
    "on-click": "bash ~/.config/hypr/scripts/audio-menu.sh",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  }
}
