# Maintainer: Dwarf1er
pkgname=sobarch-limine-snapshots
# pkgver tracks the date these scripts last changed.
pkgver=20261019
pkgrel=2
pkgdesc="Bespoke Limine boot-entry sync for Snapper snapshots (Limine equivalent of grub-btrfs, decision #12)"
arch=('any')
url="https://github.com/Dwarf1er/sobarch"
license=('MIT')
depends=('bash' 'inotify-tools' 'snapper' 'btrfs-progs')
# Nothing to strip; also avoids needing debugedit on a fresh archinstall base.
options=('!debug')
source=()
sha256sums=()

package() {
    install -Dm755 "$startdir/sobarch-limine-snapshot-sync" "$pkgdir/usr/bin/sobarch-limine-snapshot-sync"
    install -Dm755 "$startdir/sobarch-limine-snapshotd" "$pkgdir/usr/bin/sobarch-limine-snapshotd"
    install -Dm644 "$startdir/sobarch-limine-snapshotd.service" "$pkgdir/usr/lib/systemd/system/sobarch-limine-snapshotd.service"
}
