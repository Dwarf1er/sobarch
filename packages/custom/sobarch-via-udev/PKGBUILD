# Maintainer: Dwarf1er
pkgname=sobarch-via-udev
# pkgver tracks the date 61-via.rules last changed.
pkgver=20261019
pkgrel=1
pkgdesc="Opt-in udev rule granting hidraw access for VIA keyboard configuration (usevia.app)"
arch=('any')
url="https://github.com/Dwarf1er/sobarch"
license=('MIT')
# Nothing to strip; also avoids needing debugedit on a fresh archinstall base.
options=('!debug')
source=()
sha256sums=()

package() {
    # systemd's own udev-reload pacman hook applies the rule; no .install needed.
    install -Dm644 "$startdir/61-via.rules" "$pkgdir/usr/lib/udev/rules.d/61-via.rules"
}
