# Gives the logged-in user access to all hidraw devices so VIA (usevia.app)
# can configure keyboards without root. Nothing identifies a VIA keyboard,
# so it has to cover every hidraw device; that is why the package is opt-in.
# See https://github.com/the-via/app/issues/292
ACTION!="remove", KERNEL=="hidraw*", SUBSYSTEM=="hidraw", MODE="0660", TAG+="uaccess"
