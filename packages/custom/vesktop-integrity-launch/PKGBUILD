# Maintainer: Dwarf1er
pkgname=vesktop-integrity-launch
# To update: bump _commit and set pkgver to that commit's date (YYYYMMDD).
pkgver=20260926
pkgrel=2
_commit=b287aca3e869868d44af5424b0ab24dcfcdcaba1
pkgdesc="Self-healing launch wrapper for Vesktop: verifies Vencord files against a local baseline, runs --repair on mismatch"
arch=('any')
url="https://github.com/Dwarf1er/vesktop-integrity-launch"
license=('MIT')
# Not a hard dependency, so aur-sync install order doesn't matter; the
# hook and launcher no-op without Vesktop.
optdepends=('vesktop-bin: the app being wrapped')
options=('!debug')
makedepends=('git')
source=("$pkgname::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

package() {
    install -Dm755 "$srcdir/$pkgname/bin/vesktop-integrity-launch" "$pkgdir/usr/bin/vesktop-integrity-launch"
    install -Dm644 "$srcdir/$pkgname/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm755 "$startdir/sync-desktop-entry.sh" "$pkgdir/usr/lib/vesktop-integrity-launch/sync-desktop-entry.sh"
    install -Dm644 "$startdir/vesktop-integrity-launch.hook" "$pkgdir/usr/share/libalpm/hooks/vesktop-integrity-launch.hook"
}
