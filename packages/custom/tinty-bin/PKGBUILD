# Maintainer: Dwarf1er
pkgname=tinty-bin
# Prebuilt upstream release; the AUR only has tinty-git, too slow to build
# at install time. .github/scripts/update-tinty-bin.sh bumps pkgver and sums.
pkgver=0.34.1
pkgrel=1
pkgdesc="A base16 and base24 color scheme manager (prebuilt release binary)"
arch=('x86_64')
url="https://github.com/tinted-theming/tinty"
license=('GPL-3.0-only')
# git: tinty clones scheme/template repos with it.
depends=('git' 'glibc' 'gcc-libs')
provides=('tinty')
conflicts=('tinty' 'tinty-git')
options=('!debug')
# LICENSE and completions come from the source archive.
source=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/tinty-x86_64-unknown-linux-gnu.tar.gz"
        "$pkgname-$pkgver-src.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('311985e4b25c463c09db00e7fd8c9e50a055e07d764c7c0916b7e7e31add0fc3'
            '932c0c6b5c76d6b725ef327fdb71c54976631cc55293c1cd64f30303ace68013')

package() {
    install -Dm755 "$srcdir/tinty" "$pkgdir/usr/bin/tinty"

    cd "$srcdir/tinty-$pkgver"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 contrib/completion/tinty.bash "$pkgdir/usr/share/bash-completion/completions/tinty"
    install -Dm644 contrib/completion/tinty.fish "$pkgdir/usr/share/fish/vendor_completions.d/tinty.fish"
    install -Dm644 contrib/completion/tinty.zsh "$pkgdir/usr/share/zsh/site-functions/_tinty"
}
