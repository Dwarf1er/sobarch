# System-wide default applications for sobarch's base apps, installed as
# /etc/xdg/mimeapps.list by sobarch-skel. Lower precedence than the
# user's own ~/.config/mimeapps.list (what Super -> Sobarch -> Default
# Apps writes), so a choice made there always wins, and this file never
# goes through apply-skel.sh's diff3 merge or Review Conflicts. Without
# it, a type nobody has chosen falls through to whichever app
# mimeinfo.cache happens to list first (a browser opening JPEGs, an
# image editor opening BMPs).
#
# Generated from each app's own desktop-file MimeType list: images ->
# imv-dir (steps through the rest of the folder; plain imv as fallback),
# audio/video -> mpv, web/HTML/PDF -> LibreWolf, folders -> PCManFM,
# archives -> xarchiver minus the document, ebook, comic and executable
# formats it also claims (EPUB, ODT, DOCX, CHM, CBZ/CBR, FB2, AppImage,
# Snap, browser/office extensions), which must not open as archives.
# Text is deliberately absent: the base editor is Neovim, a
# Terminal=true app, and xdg-open's generic mode (Hyprland sessions)
# runs Exec directly without a terminal, so it would start with no
# window at all.

[Default Applications]
application/gzip=xarchiver.desktop;
application/java-archive=xarchiver.desktop;
application/pdf=librewolf.desktop;
application/vnd.android.app-bundle=xarchiver.desktop;
application/vnd.android.package-archive=xarchiver.desktop;
application/vnd.bzip3=xarchiver.desktop;
