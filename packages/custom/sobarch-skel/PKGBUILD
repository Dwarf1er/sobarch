# Maintainer: Dwarf1er
pkgname=sobarch-skel
# Pure-data meta-package with no upstream releases of its own; pkgver
# tracks the date skel/ last changed in this monorepo.
pkgver=20260915
pkgrel=2
pkgdesc="Sobarch distribution-owned default desktop configuration (skel)"
arch=('any')
url="https://github.com/Dwarf1er/sobarch"
license=('MIT')
# Pure-data package with no compiled binaries, so there's nothing to
# strip or generate debug info for; disabling debug avoids needing the
# debugedit package on the build host (not present on a fresh
# archinstall base).
options=('!debug')
source=()
sha256sums=()

package() {
    install -dm755 "$pkgdir/usr/share/sobarch/skel"
    cp -a "$startdir/../../../skel/." "$pkgdir/usr/share/sobarch/skel/"

    # Normalize permissions: some source files (e.g. fcitx5's own config,
    # which it writes as 600) must stay world-readable once packaged, since
    # a regular user (not root) needs to read them back out of
    # /usr/share/sobarch/skel/ later (sobarch update-config).
    find "$pkgdir/usr/share/sobarch/skel" -type d -exec chmod 755 {} +
    find "$pkgdir/usr/share/sobarch/skel" -type f -exec chmod 644 {} +
    chmod 755 "$pkgdir"/usr/share/sobarch/skel/.config/hypr/scripts/*.sh
    chmod 755 "$pkgdir"/usr/share/sobarch/skel/.config/waybar/scripts/*.sh

    # Profile/package data for setup-package-menu.sh, a plain-text mirror
    # of installer/tui/profiles_data.py (see generate_profile_data.py).
    # Installed outside the skel/ tree above, not under it: it's
    # distro-owned data the user never edits, not a personalizable
    # config file, so it must never go through apply-skel.sh's diff3
    # reconciliation the way everything under skel/ does.
    install -Dm644 "$startdir/data/profiles.txt" "$pkgdir/usr/share/sobarch/profiles.txt"

    # Greeter/bootloader branding assets, same "outside skel/" reasoning
    # as profiles.txt above: ly-theme-setup.sh and limine-theme-setup.sh
    # both run inside arch-chroot before the target user's $HOME exists,
    # so they read these from the package payload rather than from a
    # skel-deployed path.
    #
    # sobarch-logo.dur is a prebuilt ly DurFile animation (gzip-compressed
    # JSON; see ly-theme-setup.sh's own header comment for why this isn't
    # generated at install time the way the old Lua-based logo was), not
    # regenerated from sobarch-logo-ascii.txt automatically -- if the mark
    # in that ascii file ever changes, this .dur has to be rebuilt by hand
    # to match, same as sobarch-logo-lockscreen.png below already is.
    install -Dm644 "$startdir/../../../branding/sobarch-logo.dur" "$pkgdir/usr/share/sobarch/branding/sobarch-logo.dur"
    # 512x512, mostly-transparent mark (not the full opaque desktop
    # wallpaper): centered at native size over Limine's `backdrop`
    # colour, it stays small enough not to fight the menu text for
    # space, unlike the full-screen wallpaper this replaced.
    install -Dm644 "$startdir/../../../branding/sobarch-logo-lockscreen.png" "$pkgdir/usr/share/sobarch/branding/sobarch-logo.png"
}
