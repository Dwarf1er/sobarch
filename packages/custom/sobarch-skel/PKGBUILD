# Maintainer: Dwarf1er
pkgname=sobarch-skel
# pkgver tracks the date skel/ last changed.
pkgver=20261021
pkgrel=3
pkgdesc="Sobarch distribution-owned default desktop configuration (skel)"
arch=('any')
backup=('etc/xdg/mimeapps.list')
url="https://github.com/Dwarf1er/sobarch"
license=('MIT')
# Nothing to strip; also avoids needing debugedit on a fresh archinstall base.
options=('!debug')
source=()
sha256sums=()

package() {
    install -dm755 "$pkgdir/usr/share/sobarch/skel"
    cp -a "$startdir/../../../skel/." "$pkgdir/usr/share/sobarch/skel/"

    # Some sources are 600 (fcitx5 writes its config that way), but users
    # must be able to read the packaged copy.
    find "$pkgdir/usr/share/sobarch/skel" -type d -exec chmod 755 {} +
    find "$pkgdir/usr/share/sobarch/skel" -type f -exec chmod 644 {} +
    chmod 755 "$pkgdir"/usr/share/sobarch/skel/.config/hypr/scripts/*.sh
    chmod 755 "$pkgdir"/usr/share/sobarch/skel/.config/waybar/scripts/*.sh

    # Files below are distro-owned, so they live outside skel/ and are
    # never diff3-merged into $HOME.
    install -Dm644 "$startdir/data/profiles.txt" "$pkgdir/usr/share/sobarch/profiles.txt"

    # Ranks below ~/.config/mimeapps.list, so user choices never conflict.
    install -Dm644 "$startdir/data/mimeapps.list" "$pkgdir/etc/xdg/mimeapps.list"

    # sobarch-wordmark.dur is built by hand from the ASCII wordmark; rebuild
    # it if the wordmark changes.
    install -Dm644 "$startdir/../../../branding/sobarch-wordmark-ascii.txt" "$pkgdir/usr/share/sobarch/branding/sobarch-wordmark-ascii.txt"
    install -Dm644 "$startdir/../../../branding/sobarch-wordmark.dur" "$pkgdir/usr/share/sobarch/branding/sobarch-wordmark.dur"
    install -Dm644 "$startdir/../../../branding/sobarch-logo-lockscreen.png" "$pkgdir/usr/share/sobarch/branding/sobarch-logo.png"

    install -Dm644 "$startdir/../../../branding/plymouth-sobarch/sobarch.plymouth" "$pkgdir/usr/share/sobarch/branding/plymouth-sobarch/sobarch.plymouth"
    install -Dm644 "$startdir/../../../branding/plymouth-sobarch/sobarch.script" "$pkgdir/usr/share/sobarch/branding/plymouth-sobarch/sobarch.script"
}
