pkgrel=1
pkgdesc="A base16, base24 and tinted8 color scheme manager"
arch=('x86_64')
url="https://github.com/tinted-theming/tinty"
license=('GPL3')
options=('!strip' '!debug')
provides=('tinty')
conflicts=('tinty')
source=("tinty-$pkgver-x86_64.tar.gz::https://github.com/tinted-theming/tinty/releases/download/v$pkgver/tinty-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('311985e4b25c463c09db00e7fd8c9e50a055e07d764c7c0916b7e7e31add0fc3')

package() {
  install -Dm755 "$srcdir/tinty" "$pkgdir/usr/bin/tinty"
}
