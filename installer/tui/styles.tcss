/* ratatui-style: plain box-drawing borders with the title set into the
   top edge, a bright border on whatever has focus, `>` highlight bars,
   one-line label/control rows, and a key-chip footer. Palette comes
   from theme.py. */

Screen {
    background: $background;
    layout: vertical;
}

#titlebar {
    height: 1;
}

#title-left {
    width: 1fr;
}

#title-right {
    width: auto;
    color: $foreground 60%;
}

#body {
    height: 1fr;
}

/* Panels */

#steps, Section, #status {
    border: solid $foreground 35%;
    border-title-color: $foreground 70%;
    border-title-style: bold;
    background: $background;
}

#steps:focus, Section:focus-within {
    border: solid $primary;
    border-title-color: $primary;
}

#steps {
    width: 24;
    height: 1fr;
    scrollbar-size-vertical: 0;
}

#sections {
    width: 1fr;
    height: 1fr;
}

Section {
    height: 1fr;
    padding: 1 2;
    scrollbar-size-vertical: 1;
}

#status {
    height: 3;
    padding: 0 1;
}

/* Lists: a solid highlight bar instead of Textual's default tint */

OptionList, SelectionList {
    background: $background;
    border: none;
    padding: 0;
    height: auto;
    max-height: 100%;
}

OptionList > .option-list--option-highlighted,
SelectionList > .option-list--option-highlighted {
    background: $foreground 15%;
    text-style: none;
}

OptionList:focus > .option-list--option-highlighted,
SelectionList:focus > .option-list--option-highlighted {
    background: $primary;
    color: $background;
    text-style: bold;
}

#steps > .option-list--option-highlighted {
    background: $foreground 15%;
}

#steps:focus > .option-list--option-highlighted {
    background: $primary;
    color: $background;
}

/* Rows and fields */

Row {
    height: 1;
    margin-bottom: 1;
}

.row-label {
    width: 14;
    color: $foreground 70%;
}

Input, Select {
    width: 1fr;
    border: none;
    background: $surface;
    padding: 0 1;
}

Input:focus, Select:focus {
    background: $primary 30%;
    border: none;
}

Input > .input--placeholder {
    color: $foreground 35%;
}

SelectCurrent {
    border: none;
    background: $surface;
    padding: 0 1;
}

SelectOverlay {
    border: solid $primary;
    background: $background;
}

Toggle {
    height: 1;
    margin-bottom: 1;
}

Toggle:focus {
    background: $primary;
    color: $background;
    text-style: bold;
}

Toggle:disabled {
    color: $foreground 40%;
}

.heading {
    color: $primary;
    text-style: bold;
    margin-top: 1;
}

.heading:first-child {
    margin-top: 0;
}

.note {
    color: $foreground 60%;
    margin-bottom: 1;
}

.error {
    color: $error;
    margin-bottom: 1;
}

/* Disk */

#disk-choice {
    margin-bottom: 1;
}

#encryption-fields {
    height: auto;
    margin-top: 1;
}

/* Software */

#profiles {
    height: 1fr;
    min-height: 6;
}

#profile-nav {
    width: 28;
    height: 1fr;
    border-right: solid $foreground 35%;
}

#profile-detail {
    width: 1fr;
    height: 1fr;
    padding-left: 1;
}

#profile-detail SelectionList {
    height: 1fr;
}

#profiles:disabled {
    opacity: 50%;
}

/* Install */

#summary {
    height: auto;
    margin-bottom: 1;
}

#install-actions {
    margin-bottom: 1;
}

#log {
    height: 1fr;
    background: $background;
}

/* Footer as ratatui-style key chips */

Footer {
    background: $background;
}

FooterKey {
    background: $background;
    color: $foreground 70%;
}

FooterKey .footer-key--key {
    background: $foreground 25%;
    color: $foreground;
    text-style: bold;
}
