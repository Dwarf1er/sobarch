#!/usr/bin/env bash
# NetworkManager dispatcher hook that starts the network-dependent first-boot
# units. They can't run at boot: WiFi secrets live in oo7, which only unlocks
# once the user's session is up. Each unit's marker makes repeat starts no-ops.

interface="$1"
action="$2"

case "$action" in
    up|connectivity-change)
        systemctl start --no-block sobarch-firstboot-packages.service
        systemctl start --no-block sobarch-firstboot-security.service
        systemctl start --no-block sobarch-firstboot-rescue.service
        ;;
esac
