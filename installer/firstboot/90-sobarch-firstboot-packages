#!/usr/bin/env bash
# NetworkManager dispatcher hook: (re)triggers sobarch's deferred
# first-boot package install (installer/firstboot/
# install-profile-packages.sh) as soon as a
# connection actually comes up, not just at boot.
#
# sobarch-firstboot-packages.service's own `After=network-online.target`
# ordering only helps when a connection is already configured to
# auto-connect. On a fresh WiFi-only install there's no saved
# connection yet (nothing in this project's archinstall config carries
# WiFi credentials into the target - see network_config in base.json),
# so nothing brings network-online.target up until the user manually
# connects, which typically only happens after logging into a desktop
# session. Without this hook, the service would only ever get retried
# on the next reboot instead of running as soon as network is actually
# available.
#
# Cheap and safe to fire on every "up"/connectivity-change event:
# the service's own ConditionPathExists marker makes a start() on an
# already-completed run a near-instant no-op.

interface="$1"
action="$2"

case "$action" in
    up|connectivity-change)
        systemctl start --no-block sobarch-firstboot-packages.service
        ;;
esac
