# makepkg build artifacts (packages/aur/*/, packages/custom/*/)
pkg/
src/
*.pkg.tar.*

# Python bytecode (installer/tui/)
__pycache__/
*.pyc

# Installer test output
sobarch-install-output/*

# tinty-rendered theme output for sobarch's own local template items
