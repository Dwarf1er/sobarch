#!/usr/bin/env bash
# Thin dispatcher over the scripts in /usr/local/lib/sobarch/, shared with
# the fuzzel menus.

set -euo pipefail

LIB="/usr/local/lib/sobarch"

usage() {
    cat <<'USAGE'
Usage: sobarch <command> [args]

  update [--gui]          full system update: pacman -Syu, vendored
                          AUR/custom packages, config reconciliation
  review-conflicts [--gui]
                          resolve .sobarch-new conflicts left by a
                          previous update
  aur-sync [PKG...]       update (no args) or install (PKG...) vendored
                          AUR/custom packages
  snapshot-restore [--yes] <N>
                          make Snapper snapshot N the permanent root
                          (takes effect after a reboot)
  rescue-refresh          re-fetch the Arch ISO onto the rescue
                          partition
  doctor [--write]        print a redacted diagnostic report for bug
                          reports (--write saves it under your home)
  help                    show this message
USAGE
}

# Not listed in usage: `channel [--yes] [stable|develop]` shows or sets the
# update channel, for testers (see the Updating docs).

# sudo when there's a terminal for the password prompt, else pkexec.
as_root() {
    if ((EUID == 0)); then
        exec "$@"
    elif [[ -t 0 ]] && command -v sudo >/dev/null 2>&1; then
        exec sudo "$@"
    else
        exec pkexec "$@"
    fi
}

channel_cmd() {
    local file="/etc/sobarch/channel" current="stable" yes=false
    if [[ "${1:-}" == "--yes" ]]; then
        yes=true
        shift
    fi
    [[ -r "$file" && "$(tr -d '[:space:]' <"$file")" == "develop" ]] && current="develop"
    if (($# == 0)); then
        echo "$current"
        exit 0
    fi
    case "$1" in
        stable | develop) ;;
        *)
            echo "sobarch: channel must be 'stable' or 'develop'" >&2
            exit 2
            ;;
    esac
    if [[ "$1" == "$current" ]]; then
        echo "Already on $1."
        exit 0
    fi
    if [[ "$current" == "develop" ]] && ! $yes; then
        cat >&2 <<'WARN'
Switching develop -> stable does not downgrade anything. Packages and
configs already updated from develop stay, and may be newer than stable
expects. To undo them, restore a snapshot from before you switched.
WARN
        if [[ ! -t 0 ]]; then
            echo "sobarch: refusing without a terminal; pass --yes to proceed" >&2
            exit 1
        fi
        read -r -p "Switch to stable anyway? [y/N] " answer
        [[ "$answer" =~ ^[Yy]$ ]] || exit 1
    fi
    as_root bash -c 'mkdir -p /etc/sobarch && echo "$1" >/etc/sobarch/channel' _ "$1"
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    update) exec "$LIB/update-system.sh" "$@" ;;
    review-conflicts) exec "$LIB/update-system.sh" --review "$@" ;;
    aur-sync) as_root "$LIB/aur-sync.sh" "$@" ;;
    snapshot-restore) as_root "$LIB/snapshot-rollback.sh" --online "$@" ;;
    rescue-refresh) as_root "$LIB/refresh-rescue-iso.sh" "$@" ;;
    channel) channel_cmd "$@" ;;
    doctor) exec "$LIB/doctor.sh" "$@" ;;
    help | -h | --help) usage ;;
    *)
        echo "sobarch: unknown command '$cmd'" >&2
        usage >&2
        exit 2
        ;;
esac
