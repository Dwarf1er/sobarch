# Runs aur-sync after upgrades. pacman still holds db.lck during
# PostTransaction, so aur-sync is started as a detached systemd unit.
# Skipped for aur-sync's own pacman calls and when systemd isn't running
# (install chroot).
[Trigger]
Operation = Upgrade
Type = Package
Target = *

[Action]
Description = sobarch: checking vetted AUR/custom packages for updates...
When = PostTransaction
Exec = /usr/bin/bash -c '[ -z "$SOBARCH_AUR_SYNC_RUNNING" ] && [ -d /run/systemd/system ] && systemd-run --quiet --no-block --unit=sobarch-aur-sync /usr/local/lib/sobarch/aur-sync.sh --notify; exit 0'
